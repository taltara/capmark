{
  "name": "capmark",
  "version": "0.3.1",
  "description": "Declare what an AI agent plugin may do, in Markdown, and check it. Drafts the manifest for you from what the plugin already declares.",
  "keywords": [
    "capabilities",
    "permissions",
    "agent",
    "ai-agent",
    "plugin",
    "manifest",
    "security",
    "supply-chain",
    "sandbox",
    "dsh",
    "deepseek-harness",
    "agent-skills",
    "mcp"
  ],
  "license": "MIT",
  "author": "talosteam",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "tsdown": "^0.15.6"
  },
  "bin": {
    "capmark": "./lib/bin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/taltara/capmark.git",
    "directory": "packages/capmark"
  },
  "homepage": "https://github.com/taltara/capmark#readme",
  "bugs": {
    "url": "https://github.com/taltara/capmark/issues"
  },
  "publishConfig": {
    "main": "./lib/index.js",
    "types": "./lib/index.d.ts",
    "bin": {
      "capmark": "./lib/bin.js"
    },
    "exports": {
      ".": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    }
  }
}
